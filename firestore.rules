rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Put your family code here, between the single quotes. This is the only line to change.
    function isFamily(code) { return code == 'YOUR-FAMILY-CODE'; }

    // Starred picks
    match /halfway/{code}/picks/{pickId} {
      allow read, delete: if isFamily(code);
      allow create, update: if isFamily(code)
        && request.resource.data.keys().hasOnly(['c', 'n', 'w', 'f'])
        && request.resource.data.c is string && request.resource.data.c.size() <= 200
        && request.resource.data.n is string && request.resource.data.n.size() <= 200
        && request.resource.data.w is string && request.resource.data.w.size() <= 200
        && request.resource.data.f is list && request.resource.data.f.size() <= 3;
    }

    // Activities, restaurants and places to stay added by the family
    match /halfway/{code}/custom/{itemId} {
      allow read, delete: if isFamily(code);
      allow create, update: if isFamily(code)
        && request.resource.data.keys().hasOnly(['city', 'sec', 'n', 'w', 'd', 'u', 'by', 'ts'])
        && request.resource.data.sec in ['in', 'out', 'gem', 'eat', 'stay']
        && request.resource.data.by in ['Brew', 'Aber', 'Kirk']
        && request.resource.data.city is string && request.resource.data.city.size() <= 120
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 120
        && request.resource.data.w is string && request.resource.data.w.size() <= 80
        && request.resource.data.d is string && request.resource.data.d.size() <= 200
        && (!('u' in request.resource.data) || (request.resource.data.u is string && request.resource.data.u.size() <= 500))
        && request.resource.data.ts is number;
    }

    // Destinations added to the map by the family
    match /halfway/{code}/places/{placeId} {
      allow read, delete: if isFamily(code);
      allow create, update: if isFamily(code)
        && request.resource.data.keys().hasOnly(['name', 'st', 'lat', 'lon', 'by', 'ts'])
        && request.resource.data.by in ['Brew', 'Aber', 'Kirk']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.st is string && request.resource.data.st.size() == 2
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.ts is number;
    }

    // Shared travel dates
    match /halfway/{code}/trip/{docId} {
      allow read, delete: if isFamily(code);
      allow create, update: if isFamily(code)
        && request.resource.data.keys().hasOnly(['start', 'end', 'by', 'ts'])
        && request.resource.data.start is string && request.resource.data.start.size() <= 10
        && request.resource.data.end is string && request.resource.data.end.size() <= 10
        && request.resource.data.by in ['Brew', 'Aber', 'Kirk', '']
        && request.resource.data.ts is number;
    }
  }
}
